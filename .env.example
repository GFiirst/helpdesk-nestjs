#front-cors
ORIGIN="http://localhost:3000"

PORT=4321

# Salt value for password hashing
BCRYPT_SALT=yourSaltValue

# Default Admin User
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=123
ADMIN_BRANCH=ALL