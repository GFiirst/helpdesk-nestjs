NODE_ENV=development

JWT_REFRESH_SECRET="replace-with-a-distinct-random-refresh-secret-32-chars"

JWT_SECRET="replace-with-a-distinct-random-access-secret-32-chars"
JWT_RESET_SECRET="replace-with-a-distinct-random-reset-secret-32-chars"
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_RESET_EXPIRATION_MINUTES=15
MAX_ACTIVE_SESSIONS=5

DB_TYPE="postgres"
DB_HOST=localhost
DB_PORT=5432
POSTGRES_PORT=5433
DB_USERNAME=yourDBUser  
DB_PASSWORD=yourPassword
DB_NAME=helpdesk
DB_SYNC=false
APPLY_MIGRATIONS_ON_STARTUP=true

#front-cors
ORIGIN="http://localhost:3000"
COOKIE_SECURE=false
FRONTEND_URL="http://localhost:3000"

# SMTP Configuration
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=

# Encrypted file storage (generate the KEK with: openssl rand -base64 32)
FILE_PATH=uploads
FILE_MAX_BYTES=10485760
FILE_ENCRYPTION_KEK=

PORT=4321

# Salt value for password hashing
BCRYPT_SALT=12

# Default Admin User
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=123
ADMIN_NAME=Admin
ADMIN_BRANCH=ALL
