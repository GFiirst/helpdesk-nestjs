#front-cors
ORIGIN="http://localhost:3000"
COOKIE_SECURE=false

PORT=4321

# Salt value for password hashing
BCRYPT_SALT=12

# Default Admin User
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=123
ADMIN_NAME=Admin
ADMIN_BRANCH=ALL
