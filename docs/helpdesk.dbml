Enum token_status {
  active
  revoked
}

Enum audit_action {
  create
  update
  delete
}

Enum ticket_status {
  open
  in_progress
  pending
  resolved
  closed
  cancelled
}

Enum ticket_priority {
  low
  medium
  high
  critical
}

Table credential {
  id uuid [pk]
  emailEncrypted varchar(512) [not null]
  emailHash varchar(64) [not null, note: 'HMAC-SHA-256 of the normalized email']
  password varchar(255) [not null]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
  deletedAt timestamptz

  indexes {
    emailHash [unique, name: 'credential_email_hash_unique_active']
  }
}

Table user {
  id uuid [pk]
  credentialId uuid [unique, ref: > credential.id]
  profileId uuid [unique, ref: > profile.id]
  departmentId uuid [ref: > department.id]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
  deletedAt timestamptz
}

Table profile {
  id uuid [pk]
  name varchar [not null]
  phone varchar
  remoteAccess varchar
  isAvailable boolean [not null, default: true]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
  deletedAt timestamptz
}

Table refresh_token {
  id uuid [pk]
  token varchar(64) [not null, unique, note: 'SHA-256 hash']
  expiresAt timestamptz [not null]
  status token_status [not null, default: 'active']
  userAgent varchar
  device varchar
  ip varchar
  credentialId uuid [ref: > credential.id]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
  deletedAt timestamptz
}

Table roles {
  id uuid [pk]
  role varchar [not null]
}

Table permissions {
  id uuid [pk]
  action varchar [not null]
  subject varchar [not null]
}

Table branches {
  id uuid [pk]
  name varchar(200) [not null, unique]
}

Table department {
  id uuid [pk]
  name varchar(120) [not null, unique]
  description text
  isActive boolean [not null, default: true]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
}

Table user_roles_roles {
  userId uuid [ref: > user.id]
  rolesId uuid [ref: > roles.id]
  indexes { (userId, rolesId) [pk] }
}

Table roles_permissions_permissions {
  rolesId uuid [ref: > roles.id]
  permissionsId uuid [ref: > permissions.id]
  indexes { (rolesId, permissionsId) [pk] }
}

Table branches_users_user {
  branchesId uuid [ref: > branches.id]
  userId uuid [ref: > user.id]
  indexes { (branchesId, userId) [pk] }
}

Table audit_log {
  id uuid [pk]
  action audit_action [not null]
  entityName varchar(120) [not null]
  entityId varchar(255)
  actorId uuid
  ipHash varchar(64)
  changes jsonb
  createdAt timestamptz [not null]

  indexes {
    (entityName, entityId)
    actorId
  }
}

Table ticket_category {
  id uuid [pk]
  name varchar(120) [not null, unique]
  description text
  parentId uuid [ref: > ticket_category.id]
  isActive boolean [not null, default: true]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
}

Table ticket {
  id uuid [pk]
  number bigint [not null, unique, increment]
  title varchar(200) [not null]
  description text [not null]

  requesterId uuid [not null, ref: > user.id]
  assignedToId uuid [ref: > user.id]
  branchId uuid [not null, ref: > branches.id]
  categoryId uuid [ref: > ticket_category.id]
  slaPolicyId uuid [ref: > sla_policy.id]

  status ticket_status [not null, default: 'open']
  priority ticket_priority [not null, default: 'medium']

  resolution text
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
  resolvedAt timestamptz
  closedAt timestamptz
  deletedAt timestamptz

  indexes {
    requesterId
    assignedToId
    branchId
    categoryId
    slaPolicyId
    (status, priority, createdAt)
  }
}

Table ticket_comment {
  id uuid [pk]
  ticketId uuid [not null, ref: > ticket.id]
  authorId uuid [not null, ref: > user.id]
  content text [not null]
  isInternal boolean [not null, default: false]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
  deletedAt timestamptz

  indexes {
    (ticketId, createdAt)
  }
}

Table ticket_attachment {
  id uuid [pk]
  ticketId uuid [not null, ref: > ticket.id]
  commentId uuid [ref: > ticket_comment.id]
  uploadedById uuid [not null, ref: > user.id]
  originalName varchar(255) [not null]
  storageKey varchar(500) [not null]
  mimeType varchar(150) [not null]
  size bigint [not null]
  createdAt timestamptz [not null]

  indexes {
    ticketId
    commentId
  }
}

Table ticket_history {
  id uuid [pk]
  ticketId uuid [not null, ref: > ticket.id]
  actorId uuid [ref: > user.id]
  eventType varchar(80) [not null]
  oldValue jsonb
  newValue jsonb
  createdAt timestamptz [not null]

  indexes {
    (ticketId, createdAt)
  }
}

Table ticket_assignment {
  id uuid [pk]
  ticketId uuid [not null, ref: > ticket.id]
  assignedToId uuid [not null, ref: > user.id]
  assignedById uuid [ref: > user.id]
  assignedAt timestamptz [not null]
  endedAt timestamptz
  reason varchar(500)

  indexes {
    (ticketId, assignedAt)
    assignedToId
  }
}

Table sla_policy {
  id uuid [pk]
  name varchar(120) [not null]
  priority ticket_priority [not null]
  firstResponseMinutes int [not null]
  resolutionMinutes int [not null]
  businessHoursOnly boolean [not null, default: true]
  isActive boolean [not null, default: true]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
}

Table support_team {
  id uuid [pk]
  name varchar(120) [not null, unique]
  description text
  isActive boolean [not null, default: true]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
}

Table support_team_member {
  teamId uuid [not null, ref: > support_team.id]
  userId uuid [not null, ref: > user.id]

  indexes {
    (teamId, userId) [pk]
  }
}
